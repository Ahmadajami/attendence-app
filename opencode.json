{
	"$schema": "https://opencode.ai/config.json",
	"model": "opencode-go/kimi-k2.7-code",
	"share": "disabled",
	"mcp": {
		"servers": {
			"svelte": {
				"type": "local",
				"command": ["npx", "-y", "@sveltejs/mcp"]
			}
		}
	},
	"permissions": [
		{ "action": "*", "resource": "*", "effect": "ask" },

		{ "action": "read", "resource": "*", "effect": "allow" },
		{ "action": "glob", "resource": "*", "effect": "allow" },
		{ "action": "grep", "resource": "*", "effect": "allow" },
		{ "action": "skill", "resource": "*", "effect": "allow" },
		{ "action": "question", "resource": "*", "effect": "allow" },
		{ "action": "execute", "resource": "*", "effect": "allow" },
		{ "action": "svelte_*", "resource": "*", "effect": "allow" },

		{ "action": "shell", "resource": "git status *", "effect": "allow" },
		{ "action": "shell", "resource": "git diff *", "effect": "allow" },
		{ "action": "shell", "resource": "git log *", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm check *", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm test *", "effect": "allow" },
		{ "action": "shell", "resource": "pnpm exec eslint *", "effect": "allow" },
		{ "action": "shell", "resource": "graphify query *", "effect": "allow" },
		{ "action": "shell", "resource": "graphify path *", "effect": "allow" },
		{ "action": "shell", "resource": "graphify explain *", "effect": "allow" },
		{ "action": "shell", "resource": "graphify update *", "effect": "allow" },
		{ "action": "shell", "resource": "rtk gain *", "effect": "allow" },
		{ "action": "shell", "resource": "rtk git status *", "effect": "allow" },
		{ "action": "shell", "resource": "rtk git diff *", "effect": "allow" },
		{ "action": "shell", "resource": "rtk git log *", "effect": "allow" },
		{ "action": "shell", "resource": "rtk pnpm check *", "effect": "allow" },
		{ "action": "shell", "resource": "rtk pnpm test *", "effect": "allow" },

		{ "action": "read", "resource": "*.env", "effect": "deny" },
		{ "action": "read", "resource": "*.env.*", "effect": "deny" },
		{ "action": "read", "resource": "*.env.example", "effect": "allow" },

		{ "action": "shell", "resource": "pnpm add *", "effect": "deny" },
		{ "action": "shell", "resource": "pnpm install *", "effect": "deny" },
		{ "action": "shell", "resource": "pnpm i *", "effect": "deny" },
		{ "action": "shell", "resource": "pnpm remove *", "effect": "deny" },
		{ "action": "shell", "resource": "pnpm update *", "effect": "deny" },
		{ "action": "shell", "resource": "npm install *", "effect": "deny" },
		{ "action": "shell", "resource": "npm i *", "effect": "deny" },
		{ "action": "shell", "resource": "pnpm dev *", "effect": "deny" },
		{ "action": "shell", "resource": "*vite dev*", "effect": "deny" },
		{ "action": "shell", "resource": "*playwright*", "effect": "deny" },
		{ "action": "shell", "resource": "git push *", "effect": "deny" },

		{ "action": "external_directory", "resource": "~/secure/*", "effect": "deny" },
		{ "action": "read", "resource": "~/secure/*", "effect": "deny" },
		{ "action": "edit", "resource": "~/secure/*", "effect": "deny" },
		{ "action": "*", "resource": "*secure/syravia*", "effect": "deny" },
		{ "action": "*", "resource": "*roster_attendance/tests*", "effect": "deny" }
	]
}
