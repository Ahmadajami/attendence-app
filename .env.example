# Local PostgreSQL (docker-compose.dev.yml, 127.0.0.1:5433). The real values live in
# ~/secure/syravia/attendance_app.env; never commit a real .env.
DATABASE_URL=postgres://attendance_app:CHANGE_ME@127.0.0.1:5433/attendance_app

# Auth: HS256 key for API access tokens (JWT), >= 32 characters (openssl rand -base64 48).
AUTH_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_XXXXXXXX
